# 数据库连接(可选; 不配置/连不上时, 服务层自动回退读取本地 flood_out/ 文件)
FLOOD_DB_HOST=localhost
FLOOD_DB_PORT=5432
FLOOD_DB_NAME=flood_analysis
FLOOD_DB_USER=postgres
FLOOD_DB_PASSWORD=123456

# 服务端口
FLOOD_PORT=8001

# ===== GeoScene Online 服务(可选; 满足竞赛"不脱离GeoScene服务器端"要求) =====
# 在 GeoScene Online(geoscene.cn) 或 ArcGIS Online 发布托管要素/影像服务后, 填入 REST 服务 URL;
# 未配置或不可用时, 前端自动回退读取本地数据。
# 注意: URL 结尾必须带图层号(如 /0), 前端会再拼接 /query?where=return_yr=<T>&f=geojson
GEOSCENE_EXTENT_URL=
# 示例(GeoScene Online): https://www.geosceneonline.cn/server/rest/services/Hosted/<项目名>/FeatureServer/0
# 示例(ArcGIS Online):     https://services1.arcgis.com/<orgId>/arcgis/rest/services/<folder>/extent/FeatureServer/0
GEOSCENE_DEPTH_URL=
# 示例: https://services1.arcgis.com/<orgId>/arcgis/rest/services/<folder>/depth/ImageServer

# ===== 外部集成(全部可选; 不配置时自动回退演示/规则路径, 服务不依赖外网) =====

# --- 实时雨情 + 72h 预报(Open-Meteo, 免费无 key, 对标§四9/10) ---
# 无需任何配置即可启用; 不可用时 /api/realtime_rain 回退演示情景, /api/forecast_flood 返回 503。

# --- LLM 智能问答(对标§四17; 配置 LLM_API_KEY 即启用 function-calling, 未配置走规则引擎) ---
# 智谱开放平台 https://open.bigmodel.cn (GLM-4-Flash 有免费额度); 亦支持任意 OpenAI 兼容接口
# 注意: key 只放本文件(gitignored), 严禁放入前端分发的 web/config.local.js
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash

# --- 预警真实触达(对标§四21; 橙/红预警触发, 同情景同等级 30 分钟冷却去重) ---
# 企业微信群机器人: 群设置→添加群机器人→复制 Webhook 地址
WECOM_WEBHOOK_URL=
# SMTP 邮件(QQ/163 邮箱开授权码; 发送给 /api/subscribe 登记的订阅者, 每批上限 20 人)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=1
